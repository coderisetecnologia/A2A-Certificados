# ─── GFSIS ──────────────────────────────────────────────────────────────
# Subdomínio da instância: https://{GFSIS_SUBDOMAIN}.gfsis.com.br/gestaofacil/rest
GFSIS_SUBDOMAIN=a2a
# Login e senha do usuário marcado como "usuário integração" no GFSIS
GFSIS_USER=
GFSIS_PASSWORD=
# Identificador do ponto de atendimento (filial) padrão para horários/agendamentos
GFSIS_PONTO_ATENDIMENTO_ID=

# ─── Suri ───────────────────────────────────────────────────────────────
# Chave enviada pela Suri no header x-api-key (gere com: openssl rand -hex 32)
SURI_API_KEY=
# Orçamento total de tempo por requisição da Suri (ms), somando retries
SURI_TIMEOUT_MS=10000

# ─── Banco (somente erros) ──────────────────────────────────────────────
# Connection string do Neon (use a versão "pooled")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Login Google (Auth.js) ─────────────────────────────────────────────
# Gere com: npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Única conta autorizada no painel
ALLOWED_EMAIL=coderisetecnologia@gmail.com

# ─── Cron ───────────────────────────────────────────────────────────────
# A Vercel envia "Authorization: Bearer ${CRON_SECRET}" nas chamadas de cron
CRON_SECRET=

# ─── Regras de negócio (valores PADRÃO) ─────────────────────────────────
# Editáveis no painel em /dashboard/configuracoes. Estes valores valem
# enquanto nada for salvo lá, e como reserva se o banco estiver indisponível.
# Fuso usado para "hoje", dia da semana e "horário já passou"
TZ_NEGOCIO=America/Fortaleza
# Dias de atendimento (0=domingo ... 6=sábado)
DIAS_ATENDIMENTO=1,2,3,4,5
# Antecedência mínima (minutos) para oferecer um horário de hoje
ANTECEDENCIA_MINIMA_MINUTOS=30
